{
  "entities": {
    "UserProfile": {
      "title": "UserProfile",
      "description": "Registered user profile details",
      "type": "object",
      "properties": {
        "userId": { "type": "string", "description": "Unique user ID matching auth.uid" },
        "email": { "type": "string", "description": "User email address" },
        "displayName": { "type": "string", "description": "User display name" },
        "photoURL": { "type": "string", "description": "Avatar photo URL" },
        "isAnonymous": { "type": "boolean", "description": "Whether user is guest" },
        "createdAt": { "type": "string", "format": "date-time", "description": "Account creation time" },
        "lastLoginAt": { "type": "string", "format": "date-time", "description": "Last sign in timestamp" }
      },
      "required": ["userId"]
    },
    "TourSession": {
      "title": "TourSession",
      "description": "Saved tour project session that can be shared with other users",
      "type": "object",
      "properties": {
        "id": { "type": "string", "description": "Unique session ID" },
        "userId": { "type": "string", "description": "Creator/Owner user ID" },
        "ownerEmail": { "type": "string", "description": "Creator email" },
        "ownerName": { "type": "string", "description": "Creator display name" },
        "title": { "type": "string", "description": "Tour title", "maxLength": 200 },
        "sessionName": { "type": "string", "description": "Custom session name chosen by the user", "maxLength": 200 },
        "projectName": { "type": "string", "description": "Project group name used to organize and categorize related sessions", "maxLength": 100 },
        "appDescription": { "type": "string", "description": "Application description" },
        "clipsCount": { "type": "number", "description": "Number of storyboard/video scenes" },
        "totalDuration": { "type": "number", "description": "Total duration in seconds" },
        "isRendered": { "type": "boolean", "description": "Whether full video is rendered" },
        "combinedVideoUrl": { "type": "string", "description": "URL to stitched master video" },
        "clips": { "type": "array", "description": "List of scenes/clips" },
        "youtubeMetadata": { "type": "object", "description": "Exported metadata" },
        "sharedWithEmails": { "type": "array", "description": "List of emails granted access" },
        "sharedWithUids": { "type": "array", "description": "List of user IDs granted access" },
        "isPublic": { "type": "boolean", "description": "Whether tour is shared publicly with all app users" },
        "createdAt": { "type": "string", "format": "date-time", "description": "Creation timestamp" },
        "updatedAt": { "type": "string", "format": "date-time", "description": "Last modified timestamp" }
      },
      "required": ["id", "userId", "title"]
    },
    "SessionAudioChunk": {
      "title": "SessionAudioChunk",
      "description": "Voiceover narration audio segment stored in subcollection with part chunking under 400KB to stay strictly within Firestore 1MB document limit",
      "type": "object",
      "properties": {
        "clipId": { "type": "string", "description": "ID of the associated scene or clip" },
        "data": { "type": "string", "description": "Base64-encoded narration audio data or part slice" },
        "audioBase64": { "type": "string", "description": "Legacy full Base64-encoded audio (when <= 400KB)" },
        "partIndex": { "type": "number", "description": "Zero-indexed slice order of the audio chunk" },
        "totalParts": { "type": "number", "description": "Total count of part slices for the audio chunk" },
        "updatedAt": { "type": "string", "format": "date-time", "description": "Audio upload timestamp" }
      },
      "required": ["clipId"]
    }
  },
  "firestore": {
    "/users/{userId}": {
      "schema": "UserProfile",
      "description": "User private profile and authentication record"
    },
    "/users/{userId}/sessions/{sessionId}": {
      "schema": "TourSession",
      "description": "Private user sessions subcollection"
    },
    "/users/{userId}/sessions/{sessionId}/audio/{audioId}": {
      "schema": "SessionAudioChunk",
      "description": "Private voiceover narration audio subcollection"
    },
    "/sessions/{sessionId}": {
      "schema": "TourSession",
      "description": "Top-level tour sessions collection supporting sharing across users"
    },
    "/sessions/{sessionId}/audio/{audioId}": {
      "schema": "SessionAudioChunk",
      "description": "Shared voiceover narration audio subcollection"
    }
  }
}
